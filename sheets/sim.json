{
  "sheet": "sim",
  "about": "Configuration of the AI vs AI match simulator (tools/sim.py). The simulator is an event model of Hangtime!'s rallies, not the Unity physics: each serve, receive, set, attack, block and dig is a probability built from the same stat values, AI settings (sim_data/game_data.json, exported from the game) and perk rows the mod uses. These coefficients are the model's tuning surface; they set how much each stat or effect matters. Use the simulator to compare (perk vs no perk, round 1 vs round 10); treat absolute win rates as estimates.",
  "columns": {
    "id": "key",
    "value": "number",
    "meaning": "what it controls",
    "verified": "how it was checked, or 'no'"
  },
  "rows": [
    {
      "id": "serve_error_base",
      "value": 0.05,
      "meaning": "chance a serve goes out or into the net",
      "verified": "no"
    },
    {
      "id": "serve_error_per_speed",
      "value": 0.1,
      "meaning": "extra serve error per 50 speed above 70",
      "verified": "no"
    },
    {
      "id": "receive_base",
      "value": 1.6,
      "meaning": "logit of receiving a 70-speed spin serve with base stats",
      "verified": "no"
    },
    {
      "id": "receive_speed",
      "value": 0.9,
      "meaning": "logit lost per 30 serve speed above 70",
      "verified": "no"
    },
    {
      "id": "float_penalty",
      "value": 0.6,
      "meaning": "logit lost receiving a float serve (wobble), per 50 FloatServe above 100",
      "verified": "no"
    },
    {
      "id": "move_weight",
      "value": 0.55,
      "meaning": "logit per 0.3 move speed above 1.5 (receives and digs)",
      "verified": "no"
    },
    {
      "id": "bump_weight",
      "value": 0.25,
      "meaning": "logit per 2 Bump above 3 (receives and digs)",
      "verified": "no"
    },
    {
      "id": "defensive_structure",
      "value": 0.3,
      "meaning": "logit bonus for AI that reads the precise landing spot",
      "verified": "no"
    },
    {
      "id": "pass_deflect_scale",
      "value": 14.0,
      "meaning": "pass quality = exp(-deflection / this); deflection = U(v/3, v)/Bump for balls faster than 65 (the game's own rule)",
      "verified": "no"
    },
    {
      "id": "perfect_receive_chance",
      "value": 0.2,
      "meaning": "chance a hard receive is perfect (game: 1 in 5 after 2 hard receives; PerfectBump makes it 1 in 3)",
      "verified": "no"
    },
    {
      "id": "set_base",
      "value": 1.2,
      "meaning": "logit the setter gets a playable set from a perfect pass",
      "verified": "no"
    },
    {
      "id": "set_quality",
      "value": 2.0,
      "meaning": "logit per unit of pass quality",
      "verified": "no"
    },
    {
      "id": "setter_move_weight",
      "value": 0.6,
      "meaning": "logit per 0.3 setter move speed above 1.5",
      "verified": "no"
    },
    {
      "id": "spike_error_base",
      "value": 0.07,
      "meaning": "chance a spike goes out or into the net",
      "verified": "no"
    },
    {
      "id": "spike_error_per_speed",
      "value": 0.08,
      "meaning": "extra spike error per 40 speed above 110",
      "verified": "no"
    },
    {
      "id": "spike_error_bad_set",
      "value": 0.1,
      "meaning": "extra spike error from a poor set (times 1 - set quality)",
      "verified": "no"
    },
    {
      "id": "block_touch_base",
      "value": -0.4,
      "meaning": "logit the blocker touches a spike (equal Block 73 vs Jump 61)",
      "verified": "no"
    },
    {
      "id": "block_stat_weight",
      "value": 0.25,
      "meaning": "logit per 5 Block (blocker reach)",
      "verified": "no"
    },
    {
      "id": "block_jump_weight",
      "value": 0.22,
      "meaning": "logit lost per 5 Jump of the attacker (hits over the block)",
      "verified": "no"
    },
    {
      "id": "block_stuff",
      "value": 0.5,
      "meaning": "chance a block touch is a stuff block (point); otherwise a soft touch the blockers' team digs easily",
      "verified": "no"
    },
    {
      "id": "block_stuff_absolute",
      "value": 0.75,
      "meaning": "stuff chance with AbsoluteBlock (Shutdown)",
      "verified": "no"
    },
    {
      "id": "soft_block_dig_bonus",
      "value": 1.2,
      "meaning": "logit bonus digging a softened (blocked) spike",
      "verified": "no"
    },
    {
      "id": "dig_base",
      "value": 0.2,
      "meaning": "logit of digging an 80-speed spike with base stats",
      "verified": "no"
    },
    {
      "id": "dig_speed",
      "value": 0.8,
      "meaning": "logit lost per 30 spike speed above 80",
      "verified": "no"
    },
    {
      "id": "dig_set_quality",
      "value": 0.6,
      "meaning": "logit lost per unit of the attacker's set quality (good sets place spikes better)",
      "verified": "no"
    },
    {
      "id": "tip_dig_base",
      "value": 0.9,
      "meaning": "logit of digging a tip",
      "verified": "no"
    },
    {
      "id": "tip_move_weight",
      "value": 0.8,
      "meaning": "logit per 0.3 move speed above 1.5 on tips (reaching short balls)",
      "verified": "no"
    },
    {
      "id": "free_ball_dig",
      "value": 2.2,
      "meaning": "logit of digging a free ball (bad set sent over)",
      "verified": "no"
    },
    {
      "id": "seconds_per_touch",
      "value": 1.2,
      "meaning": "rally clock per touch (for cooldowns and durations)",
      "verified": "no"
    },
    {
      "id": "seconds_between_rallies",
      "value": 3.0,
      "meaning": "clock between rallies",
      "verified": "no"
    },
    {
      "id": "player_skill",
      "value": 0.0,
      "meaning": "logit bonus for the player's side on every receive/dig/set (0 = plays like the game's AI; raise to model a strong human)",
      "verified": "no"
    }
  ],
  "fx_model": {
    "about": "How each effect kind changes the next play in the model. 'dig_pen' values are logits taken off the defender's next receive or dig. Visual-only kinds (trail, tint, burst, flash, shake, zoom, cutin, sound, aura, afterimages, bolt, ring) change nothing.",
