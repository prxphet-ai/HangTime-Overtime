    "id": "stable key",
    "title": "card title",
    "rarity": "common | rare | epic",
    "style": "boost | playstyle | tradeoff",
    "deltas": "stats.json id -> points (negative is a drawback)",
    "blurb": "long text shown when the card is zoomed",
    "verified": "how it was seen working, or 'no'"
  },
  "rarity_odds": {
    "about": "chance each card is in a given upgrade screen's pool (vanilla cards always are)",
