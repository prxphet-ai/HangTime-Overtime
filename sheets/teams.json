{
  "sheet": "teams",
  "about": "One row per new opponent team. Each row generates one TeamDef. A new team is a vanilla team (base) re-dressed when it spawns: new name, colors, stats, lines, a generated banner and signature perks. In Infinite and Loop runs the opponent is drawn at random from the slot's pool (vanilla + new), never repeating the last 3.",
  "columns": {
    "id": "stable key",
    "name": "team name",
    "base": "vanilla team prefab it re-dresses (must be in vanilla_teams)",
    "slot": "regular | combo | boss",
    "element": "elements.json id (theme)",
    "jersey": "hex jersey color",
    "shorts": "hex shorts color",
    "hair": "hex hair colors (setter, spiker)",
    "banner": "hex color of the team emblem disc on the gym banner (the name is written on it)",
    "pitch": "voice pitch",
    "weights": "stat weights for the team's level-ups (the game's StatWeight)",
    "intro": "match intro line",
    "win": "line when they win",
    "lose": "line when they lose",
    "got_point": "lines on scoring",
    "lost_point": "lines on conceding",
    "comment": "what your team says after beating them",
    "signature": "perks this team always has (perks.json ids)",
    "verified": "how it was seen in game, or 'no'",
    "points_offset": "extra opponent level-up points for this team at every round (team-specific tuning; negative = weaker)",
    "emblem": "banner emblem drawn by tools/emblems.py: mascot (a function there), layout (top | stacked | split), font (marker | bangers), accent (hex) -> assets/emblems/<id>.png"
  },
